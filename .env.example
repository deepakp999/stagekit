# Copy to .env and fill in.
# Your single login. Change either and restart: every device is signed out.
APP_USER=deepak
APP_PASSWORD=choose-a-long-password
# Keep 1 behind HTTPS; 0 only for http://localhost testing
COOKIE_SECURE=1
# How long a device stays signed in
SESSION_DAYS=180

# Separation preset (CPU timings per minute of audio, measured on 2 cores; 4 cores is faster):
#   balanced = UVR Kim_Vocal_2 vocals + Demucs drums/bass/other   ~3.5 min  (default)
#   fast     = Demucs only, one pass                                ~2 min
#   best     = UVR RoFormer vocals + Demucs fine-tuned              ~30 min  (GPU machines only)
SEPARATION_MODE=balanced
# Optional overrides — any model name audio-separator knows (run: audio-separator --list_models)
# VOCAL_MODEL=UVR-MDX-NET-Voc_FT.onnx
# STEM_MODEL=htdemucs_ft.yaml

# If YouTube blocks the server ("Sign in to confirm you're not a bot"),
# export cookies.txt from your browser, put it in ./data/cookies.txt and set:
# YTDLP_COOKIES=/data/cookies.txt
YTDLP_AUTO_UPDATE=1
MAX_UPLOAD_MB=200
